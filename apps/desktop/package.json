{
  "name": "@gmatch/desktop",
  "version": "1.7.2",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:vite": "vite",
    "dev:electron": "node scripts/dev-electron.cjs",
    "build": "vite build",
    "electron": "electron .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:wan": "node scripts/wan-two-peer.mjs",
    "test:wan:ice": "node scripts/wan-ice.mjs",
    "typecheck": "tsc --noEmit",
    "e2e:clean": "node scripts/clean-e2e-state.mjs",
    "check:ui-tokens": "node scripts/check-ui-tokens.mjs",
    "icon": "node scripts/make-icon.cjs",
    "dist": "npm run dist:win && npm run dist:linux",
    "dist:win": "npm run icon && npm run stage:api && npm run build && electron-builder --win portable --config.directories.output=release && npm run stage:release",
    "dist:linux": "npm run icon && npm run stage:api && npm run build && electron-builder --linux AppImage deb --config.directories.output=release && npm run stage:release",
    "pack": "electron-builder --win portable --linux AppImage deb",
    "stage:api": "node scripts/stage-api.cjs",
    "stage:release": "node scripts/stage-release.cjs"
  },
  "dependencies": {
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0",
    "motion": "^14.14.0",
    "react-apple-emojis": "^3.0.0",
    "react-holo-card-effect": "^0.1.3",
    "react-parallax-tilt": "^1.7.361",
    "styled-components": "^5.3.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@orbit/crypto": "*",
    "@orbit/protocol": "*",
    "@orbit/shared": "*",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "^1.62.1",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@remixicon/react": "^4.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "~2.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^1.31.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "dev.gmatch.desktop",
    "productName": "gMatch",
    "electronVersion": "33.4.11",
    "artifactName": "gMatch-${version}-portable.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!node_modules/**",
      "!**/node_modules/**"
    ],
    "asar": true,
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Network",
      "executableName": "gmatch"
    },
    "portable": {
      "unicode": true
    },
    "extraResources": [
      {
        "from": "../../api-stage",
        "to": "api"
      },
      {
        "from": "../../shared/blocklist.json",
        "to": "shared/blocklist.json"
      },
      {
        "from": "../../shared/sources.json",
        "to": "shared/sources.json"
      }
    ]
  },
  "description": "gMatch — adults-only (18+) idle game + social desktop app",
  "author": "gMatch <gmatch@users.noreply.github.com>",
  "homepage": "https://gmatch.pages.dev",
  "compression": "maximum"
}
