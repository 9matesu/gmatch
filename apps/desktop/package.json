{
  "name": "@gmatch/desktop",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icon": "node scripts/make-icon.cjs",
    "dist": "npm run icon && npm run stage:api && npm run build && electron-builder --win portable",
    "pack": "electron-builder --win portable",
    "stage:api": "node scripts/stage-api.cjs"
  },
  "dependencies": {
    "@orbit/crypto": "*",
    "@orbit/protocol": "*",
    "@orbit/shared": "*",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@remixicon/react": "^4.9.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "peerjs": "^1.5.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "~2.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^25.0.1",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "dev.gmatch.desktop",
    "productName": "gMatch",
    "electronVersion": "33.4.11",
    "artifactName": "gMatch-${version}-portable.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "unicode": true
    },
    "extraResources": [
      {
        "from": "../../api-stage",
        "to": "api"
      },
      {
        "from": "../../shared/blocklist.json",
        "to": "shared/blocklist.json"
      }
    ]
  },
  "description": "gMatch — adults-only (18+) idle game + social desktop app",
  "author": "gMatch"
}
