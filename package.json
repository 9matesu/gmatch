{
  "name": "gmatch",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "scripts": {
    "dev": "npm run dev -w @gmatch/desktop",
    "electron": "npm run electron -w @gmatch/desktop",
    "build": "npm run build -w @gmatch/desktop",
    "serve:api": "npm run serve -w @orbit/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}
