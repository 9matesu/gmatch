{
  "name": "goongrid",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @goongrid/desktop",
    "electron": "npm run electron -w @goongrid/desktop",
    "build": "npm run build -w @goongrid/desktop",
    "serve:api": "npm run serve -w @orbit/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}
